# cp .env.example .env 후 값을 고칩니다. .env는 git에 올리지 않습니다. uv 실행 때는 같은 이름을 환경변수로 줍니다.

# 정하면 모든 요청에서 Authorization: Bearer <값>을 검사합니다. 비우면 무인증입니다.
# 유달리 LXC 등 다른 머신에서 부를 때는 반드시 정합니다.
LINK_API_KEY=

# 유달리 설정 화면에 보일 프리셋(쉼표로 구분, README 표의 "모델 ID")
LINK_MODELS=Systran/faster-whisper-small,Systran/faster-whisper-medium,deepdml/faster-whisper-large-v3-turbo-ct2,Systran/faster-whisper-large-v3,nvidia/nemotron-3.5-asr-streaming-0.6b

# auto(NVIDIA > AMD > Intel > CPU) | cuda | rocm | openvino | cpu
LINK_DEVICE=auto
# 쓸 GPU 번호(nvidia-smi 번호, 쉼표로 구분). 비우면 전부. CUDA_VISIBLE_DEVICES와 함께 쓰지 마세요.
LINK_GPUS=
# GPU 메모리가 모자라거나 GPU를 쓸 수 없을 때 CPU로 내릴지(1) 거절할지(0)
LINK_CPU_FALLBACK=0
# 비우면 프로필별 자동. 정확성 우선은 GPU float16 유지, CPU는 RAM에 따라 float32/int8.
# 정하면 그 값으로 고정합니다.
LINK_COMPUTE_TYPE=
# 비우면 GPU 수 또는 CPU 코어 수에 맞춘 요청 대기열. CUDA 모델 워커는 GPU당 1개.
LINK_CONCURRENCY=
# accuracy(정확성 우선, 기본): 순차 추론과 GPU float16 유지. CPU는 RAM에 따라 float32/int8.
# balanced: VRAM 자동 배치 + 의심 구간 GPU 순차 재확인. throughput: 배치 처리량 우선.
LINK_PROFILE=accuracy
# CUDA Whisper: 정확성 우선 모드는 항상 배치 0(순차). 다른 모드에서 auto는 VRAM에 따라 1/2/4/8.
# 정수를 지정하면 그 크기를 상한으로 사용하며, 메모리 여유/OOM에 따라 더 줄어듭니다.
LINK_BATCH_SIZE=auto
# 배치 출력이 지나치게 짧거나 용어 나열인 구간을 같은 GPU에서 순차 재확인(권장).
# 0은 속도 비교용으로만 권장합니다. 이 검사로 모든 누락/환각을 검출할 수는 없습니다.
LINK_QUALITY_GUARD=1
# GPU당 CPU 전처리 스레드. 비우면 CPU 수와 선택한 GPU 수를 고려해 최대 4개.
LINK_CPU_THREADS=

# Docker 전용: 호스트에서 열 주소·포트. 다른 머신에서 부를 때만 0.0.0.0
LINK_BIND=127.0.0.1
LINK_PORT=8000

# 내 PC 연결 모드(compose.link.yaml): 유달리 주소, 기기 이름(비우면 컴퓨터 이름)
UDALLY_URL=https://udally.quanect.kr
LINK_NAME=
