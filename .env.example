# cp .env.example .env 후 값을 고칩니다. .env는 git에 올리지 않습니다. uv 실행 때는 같은 이름을 환경변수로 줍니다.

# 정하면 모든 요청에서 Authorization: Bearer <값>을 검사합니다. 비우면 무인증입니다.
# 유달리 LXC 등 다른 머신에서 부를 때는 반드시 정합니다.
STT_API_KEY=

# 유달리 설정 화면에 보일 프리셋(쉼표로 구분, README 표의 "모델 ID")
STT_MODELS=Systran/faster-whisper-small,Systran/faster-whisper-medium,deepdml/faster-whisper-large-v3-turbo-ct2,Systran/faster-whisper-large-v3,nvidia/nemotron-3.5-asr-streaming-0.6b

# auto(NVIDIA > AMD > Intel > CPU) | cuda | rocm | openvino | cpu
STT_DEVICE=auto
# 쓸 GPU 번호(nvidia-smi 번호, 쉼표로 구분). 비우면 전부. CUDA_VISIBLE_DEVICES와 함께 쓰지 마세요.
STT_GPUS=
# GPU 메모리가 모자라거나 GPU를 쓸 수 없을 때 CPU로 내릴지(1) 거절할지(0)
STT_CPU_FALLBACK=1
# 비우면 자동(GPU: float16 → int8_float16 → int8로 낮춤, CPU: int8). 정하면 그 값으로 고정합니다.
STT_COMPUTE_TYPE=
# 동시에 처리할 요청 수(유달리는 3)
STT_CONCURRENCY=3

# Docker 전용: 호스트에서 열 주소·포트. 다른 머신에서 부를 때만 0.0.0.0
STT_BIND=127.0.0.1
STT_PORT=8000

# 내 PC 연결 모드(compose.link.yaml): 유달리 주소, 기기 이름(비우면 컴퓨터 이름)
UDALLY_URL=https://udally.sio2.kr
STT_NAME=
